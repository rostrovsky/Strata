+void ggml_gallocr_touch_buffers(ggml_gallocr_t galloc) {
+    for (int i = 0; i < galloc->n_buffers; i++) {
+        bool seen = galloc->buffers[i] == NULL;
+        for (int j = 0; j < i && !seen; j++) {
+            seen = galloc->buffers[j] == galloc->buffers[i];
+        }
+        if (seen) {
+            continue;
+        }
+        for (int c = 0; c < GGML_VBUFFER_MAX_CHUNKS && galloc->buffers[i]->chunks[c]; c++) {
+            ggml_backend_buffer_clear(galloc->buffers[i]->chunks[c], 0);
+        }
+    }
+}
