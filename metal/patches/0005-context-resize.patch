+bool llama_context::resize(uint32_t n_batch, size_t moe_cache_size) {
+    // the memory of a sliding-window model is sized with the ubatch
+    if (model.hparams.vocab_only || n_batch == 0 || model.hparams.swa_type != LLAMA_SWA_TYPE_NONE) {
+        return false;
+    }
+
+    synchronize();
+
+    // a cache that keeps its size keeps its experts and its callbacks
+    const bool keep_cache = moe_cache && moe_cache_size == cparams.moe_cache_size;
+
+    // the old buffers go before the new ones come
+    for (auto & res : gf_res_prev) {
+        res.reset();
+    }
+    gf_res_reserve.reset();
+    gf_res_prev_active = nullptr;
+    sched.reset();
+    if (!keep_cache) {
+        moe_cache.reset();
+    }
+
+    cparams.n_batch        = cparams.causal_attn ? std::min(cparams.n_ctx, n_batch) : n_batch;
+    cparams.n_ubatch       = cparams.n_batch;
+    cparams.moe_cache_size = moe_cache_size;
+
+    // one entry per token of a batch (output_reserve sizes it only once); the last batch's outputs stay readable
+    if (!output_ids.empty() && output_ids.size() < cparams.n_batch) {
+        output_ids.resize(cparams.n_batch, -1);
+    }
+
+    try {
+        if (moe_cache_size > 0 && !keep_cache) {
+            moe_cache = std::make_unique<llama_moe_cache>(model, backend_ptrs, backend_buft, moe_cache_size);
+        }
+        sched_need_reserve = true;
+        sched_reserve();
+    } catch (const std::exception & err) {
+        LLAMA_LOG_ERROR("%s: failed to resize the context: %s\n", __func__, err.what());
+        return false;
+    }
+
+    return true;
 }
 
