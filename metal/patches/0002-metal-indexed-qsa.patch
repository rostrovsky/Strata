+// Sort the compact QSA cell list into the exact order produced by the dense-mask scan.
+// Invalid cells move to the end and become -1 padding. Integer comparisons only: the
+// attention kernel receives the same ordered cells and uses the same FP arithmetic.
+kernel void kernel_flash_attn_ext_vec_idx_i32(
+        constant ggml_metal_kargs_flash_attn_ext_vec_idx & args,
+        device const int * selected,
+        device       int * idx,
+        uint3   tgpig[[threadgroup_position_in_grid]],
+        ushort  tiitg[[thread_index_in_threadgroup]],
+        ushort3 ntg[[threads_per_threadgroup]]) {
+    threadgroup int cells[4096];
+    const int i1 = tgpig.x, i2 = tgpig.y, i3 = tgpig.z;
+    device const int * row = (device const int *) ((device const char *) selected +
+            i1*args.nb31 + i2*args.nb32 + i3*args.nb33);
+    device int * out = idx + (((int64_t)i3*args.ne32 + i2)*args.ne31 + i1)*args.n_kv_max_padded;
+    int nsort = 1;
+    while (nsort < args.n_kv_max) nsort *= 2;
+    for (int i = tiitg; i < nsort; i += ntg.x) {
+        const int cell = i < args.n_kv_max ? row[i] : -1;
+        cells[i] = cell >= 0 && cell < args.ne30 ? cell : INT_MAX;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (int k = 2; k <= nsort; k *= 2) {
+        for (int j = k/2; j > 0; j /= 2) {
+            for (int i = tiitg; i < nsort; i += ntg.x) {
+                const int other = i ^ j;
+                if (other > i) {
+                    const int a = cells[i], b = cells[other];
+                    const bool asc = (i & k) == 0;
+                    cells[i] = asc ? min(a, b) : max(a, b);
+                    cells[other] = asc ? max(a, b) : min(a, b);
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+    }
+    for (int i = tiitg; i < args.n_kv_max_padded; i += ntg.x) {
+        const int cell = i < nsort ? cells[i] : INT_MAX;
+        out[i] = cell == INT_MAX ? -1 : cell;
+    }
+}
