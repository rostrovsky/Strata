+void llama_get_compute_buffer_sizes(const llama_context * ctx, size_t * device, size_t * host) {
+    size_t n_device = 0;
+    size_t n_host   = 0;
+    for (const auto & [buft, mb] : ctx->memory_breakdown()) {
+        ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+        if (dev == nullptr || ggml_backend_dev_type(dev) == GGML_BACKEND_DEVICE_TYPE_CPU) {
+            n_host += mb.compute;
+        } else {
+            n_device += mb.compute;
+        }
+    }
+    if (device) {
+        *device = n_device;
+    }
+    if (host) {
+        *host = n_host;
+    }
 }
 
