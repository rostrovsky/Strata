+void ggml_backend_metal_get_perf(struct ggml_backend_metal_perf * perf) {
+    perf->t_wait_us   = atomic_load(&g_perf_wait_us);
+    perf->t_encode_us = atomic_load(&g_perf_encode_us);
+    perf->t_gpu_us    = atomic_load(&g_perf_gpu_us);
+    perf->n_wait      = atomic_load(&g_perf_n_wait);
+    perf->n_graphs    = atomic_load(&g_perf_n_graphs);
+}
+
+static void ggml_metal_perf_track(id<MTLCommandBuffer> cmd_buf) {
+    [cmd_buf addCompletedHandler:^(id<MTLCommandBuffer> cb) {
+        const double t = cb.GPUEndTime - cb.GPUStartTime;
+        if (t > 0.0) {
+            atomic_fetch_add(&g_perf_gpu_us, (uint64_t) (t*1e6));
+        }
+    }];
+}
+
+// GGML_METAL_PROFILE: every node in a command buffer of its own, the GPU time summed by op and weight type
+#define GGML_METAL_PROFILE_MAX 256
+static struct { char key[96]; double t; uint64_t n; uint64_t bytes; } g_prof[GGML_METAL_PROFILE_MAX];
+static int g_prof_n = 0;
+
+static void ggml_metal_profile_print(void) {
+    double total = 0.0;
+    for (int i = 0; i < g_prof_n; ++i) {
+        total += g_prof[i].t;
+    }
+    fprintf(stderr, "ggml_metal_profile: %.3f s of GPU time\n", total);
+    for (;;) {
+        int best = -1;
+        for (int i = 0; i < g_prof_n; ++i) {
+            if (g_prof[i].n > 0 && (best < 0 || g_prof[i].t > g_prof[best].t)) {
+                best = i;
+            }
+        }
+        if (best < 0) {
+            break;
+        }
+        fprintf(stderr, "ggml_metal_profile: %6.2f%% %9.3f s %8llu x %7.1f us %8.1f MiB/op  %s\n", 100.0*g_prof[best].t/total, g_prof[best].t,
+                (unsigned long long) g_prof[best].n, 1e6*g_prof[best].t/g_prof[best].n, g_prof[best].bytes/1048576.0/g_prof[best].n, g_prof[best].key);
+        g_prof[best].n = 0;
+    }
+}
+
+static void ggml_metal_profile_add(const struct ggml_tensor * node, double t) {
+    char key[96];
+    const struct ggml_tensor * w = node->src[0];
+    uint64_t bytes = 0;
+    if ((node->op == GGML_OP_MUL_MAT || node->op == GGML_OP_MUL_MAT_ID) && w != NULL) {
+        const int64_t n_cols = node->op == GGML_OP_MUL_MAT ? node->src[1]->ne[1]*node->src[1]->ne[2] : node->src[2]->ne[1];
+        snprintf(key, sizeof(key), "%s %s [%lld x %lld] cols=%lld", ggml_op_name(node->op), ggml_type_name(w->type), (long long) w->ne[0], (long long) w->ne[1], (long long) n_cols);
+        bytes = node->op == GGML_OP_MUL_MAT ? ggml_nbytes(w) : w->nb[2]*ggml_nelements(node->src[2]);
+    } else {
+        snprintf(key, sizeof(key), "%s", ggml_op_desc(node));
+    }
+    int i = 0;
+    while (i < g_prof_n && strcmp(g_prof[i].key, key) != 0) {
+        i++;
+    }
+    if (i == g_prof_n) {
+        if (g_prof_n == GGML_METAL_PROFILE_MAX) {
+            return;
+        }
+        if (g_prof_n++ == 0) {
+            atexit(ggml_metal_profile_print);
+        }
+        strcpy(g_prof[i].key, key);
+    }
+    g_prof[i].t += t;
+    g_prof[i].n += 1;
+    g_prof[i].bytes += bytes;
+}
+
+static void ggml_metal_graph_compute_profile(ggml_metal_t ctx, struct ggml_cgraph * gf) {
+    id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+    if (ctx->cmd_buf_last) {
+        [ctx->cmd_buf_last waitUntilCompleted];
+        ctx->cmd_buf_last = nil;
+    }
+    for (int i = 0; i < gf->n_nodes; ) {
+        // the encoder counts the nodes that are not empty
+        if (ggml_op_is_empty(gf->nodes[i]->op) || ggml_is_empty(gf->nodes[i])) {
+            i++;
+            continue;
+        }
+        id<MTLCommandBuffer> cmd_buf = [queue commandBuffer];
+        ggml_metal_op_t ctx_op = ggml_metal_op_init(ctx->dev, cmd_buf, gf, ctx->finfo, i, gf->n_nodes, ctx->use_concurrency, false, ctx->debug_graph);
+        const int res = ggml_metal_op_encode(ctx_op, 0);
+        ggml_metal_op_free(ctx_op);
+        [cmd_buf commit];
+        [cmd_buf waitUntilCompleted];
+        ggml_metal_profile_add(gf->nodes[i], cmd_buf.GPUEndTime - cmd_buf.GPUStartTime);
+        for (int n = res > 0 ? res : 1; n > 0 && i < gf->n_nodes; i++) {
+            if (!ggml_op_is_empty(gf->nodes[i]->op) && !ggml_is_empty(gf->nodes[i])) {
+                n--;
+            }
+        }
+    }
+}
