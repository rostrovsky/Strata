+    }
+}
+
+bool llama_moe_cache_get_stats(const llama_context * ctx, llama_moe_cache_stats * stats) {
+    if (!ctx->get_moe_cache()) {
+        return false;
+    }
+    *stats = ctx->get_moe_cache()->get_stats();
+    return true;
+}
+
+int64_t llama_moe_cache_preload(llama_context * ctx, const int32_t * layers, const int32_t * experts, size_t n) {
+    if (!ctx->get_moe_cache()) {
+        return 0;
+    }
+    ctx->synchronize();
+    return ctx->get_moe_cache()->preload(layers, experts, n);
