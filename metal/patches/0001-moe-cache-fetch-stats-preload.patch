+}
+
+bool llama_moe_cache::has_fetch_callback() const {
+    return pimpl->fetch_cb != nullptr;
+}
+
+bool llama_moe_cache::fetch(const llama_moe_cache_fill * fills, size_t n) const {
+    return pimpl->fetch_cb != nullptr && pimpl->fetch_cb(fills, n, pimpl->fetch_cb_user_data);
+}
+
+const int32_t * llama_moe_cache::get_slots(int32_t il, int32_t * n_expert) const {
+    if (il < 0 || il >= (int32_t) pimpl->layers.size() || pimpl->layers[il].ig < 0) {
+        return nullptr;
+    }
+    const auto & lru = pimpl->groups[pimpl->layers[il].ig].lru;
+    if (n_expert != nullptr) {
+        *n_expert = lru.n_expert;
+    }
+    return lru.slot_map[il];
+}
+
+llama_moe_cache_stats llama_moe_cache::get_stats() const {
+    return pimpl->get_stats();
+}
+
+int64_t llama_moe_cache::preload(const int32_t * layers, const int32_t * experts, size_t n) {
+    return pimpl->preload(layers, experts, n);
+}
